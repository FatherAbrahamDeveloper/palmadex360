generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EXPORT_MANAGER
  SALES
  LOGISTICS
  DOCUMENTATION
  CUSTOMER_SUPPORT
}

enum ConversationType {
  DIRECT
  GROUP
  COMPANY
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum CRMContactSource {
  WHATSAPP
  EMAIL
  MANUAL
  IMPORT
}

enum CRMContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  FOLLOW_UP
  NEGOTIATION
  WON
  LOST
  CLOSED
}

enum CRMNoteType {
  GENERAL
  FOLLOW_UP
  CALL
  MEETING
  INTERNAL
}

enum ConversationChannel {
  INTERNAL
  WHATSAPP
  EMAIL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageSenderType {
  USER
  CONTACT
  SYSTEM
}

enum SupplierBusinessType {
  FARMER
  COOPERATIVE
  AGGREGATOR
  PROCESSOR
  MANUFACTURER
  EXPORTER
  WHOLESALER
  OTHER
}

enum BusinessRegistrationStatus {
  REGISTERED
  NOT_REGISTERED
  IN_PROGRESS
}

enum SupplierStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  MORE_INFO_REQUIRED
}

enum SupplierProductForm {
  FRESH
  DRIED
  RAW
  PROCESSED
  FROZEN
  OTHER
}

enum ExportOrderStatus {
  PENDING
  PROCESSING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ShipmentStatus {
  BOOKED
  LOADING
  AT_SEA
  CUSTOMS
  ARRIVED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  OTHER
}

enum ExpenseCategory {
  PROCUREMENT
  LOGISTICS
  SALARIES
  UTILITIES
  TAXES_DUTIES
  MARKETING
  OTHER
}

enum ComplianceStatus {
  NOT_STARTED
  DOCUMENTATION_PENDING
  IN_REVIEW
  COMPLIANT
  ACTION_REQUIRED
  EXPIRED
}

enum ComplianceRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplianceDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model CRMContact {
  id        String @id @default(cuid())
  companyId String

  firstName   String?
  lastName    String?
  displayName String

  companyName String?
  email       String?
  phone       String?

  source CRMContactSource @default(MANUAL)
  status CRMContactStatus @default(NEW)

  assignedToId String?

  lastContactAt  DateTime?
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("CRMContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  notes         CRMNote[]
  statusHistory CRMStatusHistory[]
  conversations Conversation[]
  exportOrders  ExportOrder[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, source])
  @@index([companyId, assignedToId])
  @@index([companyId, phone])
  @@index([companyId, email])
  @@index([companyId, updatedAt])
}

model CRMNote {
  id        String  @id @default(cuid())
  companyId String
  contactId String
  authorId  String?

  type    CRMNoteType @default(GENERAL)
  content String      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact CRMContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author  User?      @relation("CRMNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([contactId])
  @@index([authorId])
  @@index([createdAt])
}

model CRMStatusHistory {
  id          String  @id @default(cuid())
  companyId   String
  contactId   String
  changedById String?

  fromStatus CRMContactStatus?
  toStatus   CRMContactStatus

  note      String?  @db.Text
  createdAt DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact   CRMContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  changedBy User?      @relation("CRMStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([contactId])
  @@index([changedById])
  @@index([createdAt])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  products              Product[]
  conversations         Conversation[]
  files                 File[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  crmContacts           CRMContact[]
  crmNotes              CRMNote[]
  crmStatusHistory      CRMStatusHistory[]
  crmImportBatches      CRMImportBatch[]
  suppliers             Supplier[]
  exportOrders          ExportOrder[]
  shipments             Shipment[]
  warehouses            Warehouse[]
  stockLevels           StockLevel[]
  stockMovements        StockMovement[]
  purchaseRequests      PurchaseRequest[]
  invoices              Invoice[]
  expenses              Expense[]
  ComplianceRequirement ComplianceRequirement[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company                        Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedFiles                  File[]                        @relation("FileUploader")
  sentMessages                   Message[]                     @relation("MessageSender")
  conversationMembers            ConversationMember[]
  notifications                  Notification[]
  auditLogs                      AuditLog[]                    @relation("AuditActor")
  assignedCRMContacts            CRMContact[]                  @relation("CRMContactAssignee")
  crmNotes                       CRMNote[]                     @relation("CRMNoteAuthor")
  crmStatusChanges               CRMStatusHistory[]            @relation("CRMStatusChanger")
  crmImportBatches               CRMImportBatch[]              @relation("CRMImportUser")
  verifiedSuppliers              Supplier[]                    @relation("SupplierVerifier")
  reviewedSupplierApplications   SupplierApplication[]         @relation("SupplierApplicationReviewer")
  supplierVerificationChanges    SupplierVerificationHistory[] @relation("SupplierVerificationActor")
  createdExportOrders            ExportOrder[]                 @relation("ExportOrderCreator")
  createdShipments               Shipment[]                    @relation("ShipmentCreator")
  shipmentStatusChanges          ShipmentEvent[]               @relation("ShipmentEventActor")
  stockMovements                 StockMovement[]               @relation("StockMovementActor")
  createdPurchaseRequests        PurchaseRequest[]             @relation("PurchaseRequestCreator")
  purchaseRequestChanges         PurchaseRequestEvent[]        @relation("PurchaseRequestEventActor")
  createdInvoices                Invoice[]                     @relation("InvoiceCreator")
  recordedPayments               InvoicePayment[]              @relation("PaymentRecorder")
  createdExpenses                Expense[]                     @relation("ExpenseCreator")
  complianceRequirements         ComplianceRequirement[]
  assignedComplianceRequirements ComplianceRequirement[]       @relation("ComplianceAssignee")
  createdComplianceRequirements  ComplianceRequirement[]       @relation("ComplianceCreator")
  verifiedComplianceDocuments    ComplianceDocument[]          @relation("ComplianceDocumentVerifier")
  complianceHistory              ComplianceHistory[]           @relation("ComplianceHistoryActor")

  @@index([companyId])
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id         String  @id @default(cuid())
  companyId  String
  categoryId String?

  name        String
  description String? @db.Text
  sku         String? @db.VarChar(50)

  // Pricing (price is per `unit`, e.g. USD per ton)
  unit           String?   @default("ton") @db.VarChar(30)
  price          Decimal?  @db.Decimal(15, 2)
  priceUpdatedAt DateTime?
  currency       String?   @default("USD") @db.VarChar(10)

  // Inventory / commercial info
  stockQuantity        Decimal  @default(0) @db.Decimal(15, 3)
  minimumOrderQuantity Decimal? @db.Decimal(15, 3)
  hsCode               String?  @db.VarChar(20)
  originCountry        String?  @default("Nigeria") @db.VarChar(100)
  packaging            String?  @db.Text
  specifications       String?  @db.Text

  isNewListing Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  files        File[]
  exportOrders ExportOrder[]
  stockLevels  StockLevel[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  @@index([companyId, isActive])
  @@index([companyId, name])
}

model File {
  id           String   @id @default(cuid())
  companyId    String?
  uploadedById String?
  productId    String?
  originalName String
  storedName   String
  path         String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company             Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy          User?                @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  product             Product?             @relation(fields: [productId], references: [id], onDelete: Cascade)
  messageAttachments  MessageAttachment[]
  complianceDocuments ComplianceDocument[]

  @@index([companyId])
  @@index([uploadedById])
  @@index([productId])
}

model Conversation {
  id        String  @id @default(cuid())
  companyId String?
  contactId String?

  type    ConversationType    @default(DIRECT)
  channel ConversationChannel @default(INTERNAL)

  title String?

  externalThreadKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact CRMContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  members  ConversationMember[]
  messages Message[]

  @@index([companyId])
  @@index([contactId])
  @@index([companyId, channel])
  @@index([companyId, updatedAt])
}

model ConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String  @id @default(cuid())
  conversationId String
  senderId       String?

  type       MessageType       @default(TEXT)
  direction  MessageDirection  @default(OUTBOUND)
  senderType MessageSenderType @default(USER)

  externalKey String?  @unique
  content     String?  @db.Text
  isEdited    Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  attachments MessageAttachment[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  fileId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@index([fileId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  companyId String?
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([isRead])
}

model CRMImportBatch {
  id           String  @id @default(cuid())
  companyId    String
  importedById String?

  source   CRMContactSource
  fileName String?

  totalRecords Int @default(0)
  createdCount Int @default(0)
  updatedCount Int @default(0)
  skippedCount Int @default(0)
  errorCount   Int @default(0)

  createdAt DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  importedBy User?   @relation("CRMImportUser", fields: [importedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  companyId String?
  action    String
  entity    String?
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  user    User?    @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Supplier {
  id        String @id @default(cuid())
  companyId String

  companyName     String
  tradingName     String?
  businessType    SupplierBusinessType @default(OTHER)
  description     String?              @db.Text
  establishedDate DateTime?

  registrationStatus      BusinessRegistrationStatus @default(IN_PROGRESS)
  registrationNumber      String? // Optional CAC registration number
  registrationCountry     String?
  taxIdentificationNumber String?
  registrationAuthority   String?

  email            String
  phone            String
  alternativePhone String?
  website          String?
  contactPerson    String
  contactJobTitle  String?

  country                 String
  stateOrRegion           String?
  city                    String
  address                 String   @db.Text
  warehouseAddress        String?  @db.Text
  // Export experience
  hasExportedBefore       Boolean?
  exportExperienceYears   Int?
  previousExportCountries String?  @db.Text
  exportDestinations      String?  @db.Text

  // Operations and logistics
  logisticsCapabilities String? @db.Text
  leadTimeDays          Int?

  // Quality assurance
  qualityControlDescription String?  @db.Text
  traceabilityAvailable     Boolean?

  // Commercial information
  preferredPaymentTerms String? @db.Text
  quotationCurrency     String? @db.VarChar(10)
  tradeReferences       String? @db.Text

  status            SupplierStatus @default(PENDING)
  verifiedAt        DateTime?
  verifiedById      String?
  verificationNotes String?        @db.Text

  // Nullable until a proper rating system is implemented.
  rating Decimal? @db.Decimal(3, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  verifiedBy User? @relation("SupplierVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  products            SupplierProduct[]
  application         SupplierApplication?
  documents           SupplierDocument[]
  verificationHistory SupplierVerificationHistory[]
  purchaseRequests    PurchaseRequest[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, country, city])
  @@index([companyId, updatedAt])
  @@index([email])
}

model SupplierApplication {
  id         String @id @default(cuid())
  supplierId String @unique

  submittedAt           DateTime @default(now())
  declarationAccepted   Boolean  @default(false)
  privacyNoticeAccepted Boolean  @default(false)

  reviewNotes  String?   @db.Text
  reviewedAt   DateTime?
  reviewedById String?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  reviewedBy User? @relation("SupplierApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([submittedAt])
  @@index([reviewedById])
}

model SupplierProduct {
  id         String @id @default(cuid())
  supplierId String

  name        String
  category    String
  variety     String?
  description String? @db.Text

  productForm SupplierProductForm @default(OTHER)

  supplyCapacity   Decimal? @db.Decimal(15, 3)
  capacityUnit     String?
  minimumOrder     Decimal? @db.Decimal(15, 3)
  harvestSeasons   String?  @db.Text
  packagingOptions String?  @db.Text

  indicativePrice Decimal? @db.Decimal(15, 2)
  currency        String?  @db.VarChar(10)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([supplierId, isActive])
  @@index([category])
}

model SupplierDocument {
  id         String @id @default(cuid())
  supplierId String

  documentType String
  originalName String
  storedName   String
  path         String
  mimeType     String
  size         Int

  documentNumber String?
  issuedAt       DateTime?
  expiresAt      DateTime?

  uploadedAt DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([documentType])
}

model SupplierVerificationHistory {
  id          String  @id @default(cuid())
  supplierId  String
  changedById String?

  previousStatus SupplierStatus?
  newStatus      SupplierStatus
  notes          String?         @db.Text

  createdAt DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  changedBy User? @relation("SupplierVerificationActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([supplierId, createdAt])
  @@index([changedById])
}

model ExportOrder {
  id          String @id @default(cuid())
  companyId   String
  orderNumber String @db.VarChar(30) // e.g. EXP-2026-0001, generated server-side

  customerName String
  contactId    String? // optional link to an existing CRM contact

  productId   String? // optional link to the catalog
  productName String // snapshot, so old orders survive product edits/deletes
  quantity    Decimal @db.Decimal(15, 3)
  unit        String  @default("ton") @db.VarChar(30)

  totalValue Decimal @db.Decimal(15, 2)
  currency   String  @default("USD") @db.VarChar(10)

  status ExportOrderStatus @default(PENDING)
  notes  String?           @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact   CRMContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("ExportOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  shipments ShipmentOrder[]
  invoices  Invoice[]

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([contactId])
  @@index([productId])
}

model Shipment {
  id        String @id @default(cuid())
  companyId String

  shipmentNumber String @db.VarChar(30) // e.g. SHP-2026-0001, generated server-side

  vesselName         String
  voyageNumber       String? @db.VarChar(50)
  shippingLine       String? @db.VarChar(100)
  bookingNumber      String? @db.VarChar(50)
  billOfLadingNumber String? @db.VarChar(50)

  originPort      String // e.g. "Lagos, NG"
  destinationPort String // e.g. "Rotterdam, NL"
  etd             DateTime?
  eta             DateTime?

  containerCount Int @default(1)

  status ShipmentStatus @default(BOOKED)
  notes  String?        @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ShipmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  orders ShipmentOrder[]
  events ShipmentEvent[]

  @@unique([companyId, shipmentNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, eta])
  @@index([companyId, createdAt])
}

model ShipmentOrder {
  id            String   @id @default(cuid())
  shipmentId    String
  exportOrderId String
  createdAt     DateTime @default(now())

  shipment    Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  exportOrder ExportOrder @relation(fields: [exportOrderId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, exportOrderId])
  @@index([exportOrderId])
}

model ShipmentEvent {
  id          String  @id @default(cuid())
  shipmentId  String
  changedById String?

  fromStatus ShipmentStatus?
  toStatus   ShipmentStatus
  note       String?         @db.Text

  createdAt DateTime @default(now())

  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  changedBy User?    @relation("ShipmentEventActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([shipmentId, createdAt])
  @@index([changedById])
}

model Warehouse {
  id        String @id @default(cuid())
  companyId String

  name    String  @db.VarChar(150)
  code    String? @db.VarChar(20)
  city    String? @db.VarChar(100)
  state   String? @db.VarChar(100)
  address String? @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockLevels StockLevel[]

  @@unique([companyId, name])
  @@index([companyId])
}

model StockLevel {
  id          String @id @default(cuid())
  companyId   String
  warehouseId String
  productId   String

  quantity     Decimal  @default(0) @db.Decimal(15, 3)
  unit         String   @default("ton") @db.VarChar(30)
  capacity     Decimal? @db.Decimal(15, 3) // max this warehouse holds of this product
  reorderLevel Decimal? @db.Decimal(15, 3) // low-stock alert at or below this

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  movements StockMovement[]

  @@unique([warehouseId, productId])
  @@index([companyId])
  @@index([companyId, warehouseId])
  @@index([productId])
}

model StockMovement {
  id           String @id @default(cuid())
  companyId    String
  stockLevelId String

  type           StockMovementType
  quantityChange Decimal           @db.Decimal(15, 3) // signed: + in, - out
  balanceAfter   Decimal           @db.Decimal(15, 3)

  reference String? @db.VarChar(100) // e.g. an order or shipment number
  note      String? @db.Text

  createdById String?
  createdAt   DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockLevel StockLevel @relation(fields: [stockLevelId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("StockMovementActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([stockLevelId, createdAt])
  @@index([companyId, createdAt])
  @@index([createdById])
}

model PurchaseRequest {
  id        String @id @default(cuid())
  companyId String

  requestNumber String @db.VarChar(30) // e.g. PR-2026-0001, generated server-side

  itemName      String
  quantity      Decimal? @db.Decimal(15, 3)
  unit          String?  @db.VarChar(30)
  estimatedCost Decimal? @db.Decimal(15, 2)
  currency      String   @default("NGN") @db.VarChar(10)

  supplierId   String? // optional link to the Supplier module
  supplierName String // snapshot, or a typed-in name for one-off vendors

  requiredByDate DateTime?
  notes          String?   @db.Text

  status PurchaseRequestStatus @default(PENDING)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("PurchaseRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)

  events PurchaseRequestEvent[]

  @@unique([companyId, requestNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([supplierId])
}

model PurchaseRequestEvent {
  id                String  @id @default(cuid())
  purchaseRequestId String
  changedById       String?

  fromStatus PurchaseRequestStatus?
  toStatus   PurchaseRequestStatus
  note       String?                @db.Text

  createdAt DateTime @default(now())

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  changedBy       User?           @relation("PurchaseRequestEventActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([purchaseRequestId, createdAt])
  @@index([changedById])
}

model Invoice {
  id        String @id @default(cuid())
  companyId String

  invoiceNumber String @db.VarChar(30) // e.g. INV-2026-0001, generated server-side

  customerName  String
  exportOrderId String? // optional link to an export order

  issueDate DateTime
  dueDate   DateTime

  currency   String  @default("USD") @db.VarChar(10)
  amount     Decimal @db.Decimal(15, 2)
  amountPaid Decimal @default(0) @db.Decimal(15, 2)

  status InvoiceStatus @default(PENDING) // "Overdue" is derived from dueDate, never stored
  notes  String?       @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  exportOrder ExportOrder? @relation(fields: [exportOrderId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  payments InvoicePayment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@index([companyId, issueDate])
  @@index([exportOrderId])
}

model InvoicePayment {
  id        String @id @default(cuid())
  invoiceId String

  amount    Decimal       @db.Decimal(15, 2)
  method    PaymentMethod @default(BANK_TRANSFER)
  paidAt    DateTime
  reference String?       @db.VarChar(100)
  note      String?       @db.Text

  recordedById String?
  createdAt    DateTime @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId, paidAt])
  @@index([recordedById])
}

model Expense {
  id        String @id @default(cuid())
  companyId String

  expenseDate DateTime
  category    ExpenseCategory @default(OTHER)
  description String
  vendor      String?
  amount      Decimal         @db.Decimal(15, 2)
  currency    String          @default("USD") @db.VarChar(10)
  reference   String?         @db.VarChar(100)
  notes       String?         @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, expenseDate])
  @@index([companyId, category])
}

model ComplianceRequirement {
  id           String              @id @default(cuid())
  companyId    String
  title        String
  region       String
  authority    String?
  description  String?             @db.Text
  status       ComplianceStatus    @default(NOT_STARTED)
  riskLevel    ComplianceRiskLevel @default(MEDIUM)
  completion   Int                 @default(0)
  assignedToId String?
  createdById  String?
  dueDate      DateTime?
  expiryDate   DateTime?
  notes        String?             @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("ComplianceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("ComplianceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  documents ComplianceDocument[]
  history   ComplianceHistory[]
  User      User?                @relation(fields: [userId], references: [id])
  userId    String?

  @@index([companyId])
  @@index([companyId, status])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([expiryDate])
}

model ComplianceDocument {
  id            String                   @id @default(cuid())
  requirementId String
  fileId        String
  status        ComplianceDocumentStatus @default(PENDING)
  expiryDate    DateTime?
  verifiedById  String?
  verifiedAt    DateTime?
  notes         String?                  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirement ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  file        File                  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  verifiedBy  User?                 @relation("ComplianceDocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([requirementId, fileId])
  @@index([requirementId])
  @@index([fileId])
}

model ComplianceHistory {
  id             String            @id @default(cuid())
  requirementId  String
  userId         String?
  action         String
  details        String?           @db.Text
  previousStatus ComplianceStatus?
  newStatus      ComplianceStatus?

  createdAt DateTime @default(now())

  requirement ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  user        User?                 @relation("ComplianceHistoryActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([requirementId])
  @@index([userId])
  @@index([createdAt])
}
