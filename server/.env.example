# Copy to server/.env for local development and fill in. Never commit the real .env.
# On Render, set these under the web service's Environment tab instead.
PORT=5000
NODE_ENV=development

# Long random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a sign-in lasts (default 7d)
JWT_EXPIRES_IN=7d
# Optional: separate key for encrypting two-factor secrets. Defaults to JWT_SECRET.
# If you set it, never change it later or existing two-factor setups stop working.
DATA_ENCRYPTION_KEY=

# PostgreSQL. With Neon, copy both strings from the Neon "Connect" dialog:
#   DATABASE_URL = the POOLED connection (host contains "-pooler"), with pgbouncer=true added
#   DIRECT_URL   = the direct connection (no "-pooler"), used by migrations
# Locally, both can point at the same database.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/palmadex360?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/palmadex360?sslmode=require&connect_timeout=15"

# The web app address, used in links inside emails
APP_URL=http://localhost:5173
# Extra allowed browser origins, comma separated. palmadex360.vercel.app is built in;
# add a custom domain here, e.g. https://app.palmadex.com
CORS_ORIGINS=

# Company that new sign-ups and public supplier applications belong to.
# Leave empty to use the first company in the database (the right choice for a fresh install).
DEFAULT_COMPANY_ID=
SUPPLIER_APPLICATION_COMPANY_ID=

# Email. Pick ONE of the two options. Without either, emails are printed in the server log.
# Option 1 (use on Render's free plan, which blocks SMTP): Brevo API key from
#   Brevo > Settings > SMTP & API > API keys. MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
# Option 2 (hosts that allow SMTP): any mailbox's SMTP settings.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Palmadex 360 <noreply@your-domain.com>"

# Largest upload in MB (files are stored in the database)
MAX_UPLOAD_MB=15
# Every account must have an identity photo on file. Set to false to switch off.
FACE_ENROLLMENT_REQUIRED=true
